{
  "info": {
    "_postman_id": "a1b2c3d4-vetopia-seguridad",
    "name": "Vetopia API - Seguridad JWT",
    "description": "Colección completa de la API de Vetopia. Incluye el login de los tres roles, todas las consultas y escrituras, el portal del cliente y pruebas negativas de 401 y 403. Ejecutar primero las peticiones de la carpeta '1. Autenticación' para capturar los tokens en las variables de colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "tokenAdmin", "value": "", "type": "string" },
    { "key": "tokenVeterinario", "value": "", "type": "string" },
    { "key": "tokenCliente", "value": "", "type": "string" },
    { "key": "tokenInvalido", "value": "token.falso.invalido", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('tokenAdmin', body.token);",
                  "pm.test('Login exitoso con token y rol ADMINISTRADOR', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.token).to.be.a('string');",
                  "  pm.expect(body.rol).to.eql('ADMINISTRADOR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@vetopia.com\",\n  \"contrasena\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Login veterinario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('tokenVeterinario', body.token);",
                  "pm.test('Login exitoso con rol VETERINARIO', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.rol).to.eql('VETERINARIO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"carlos.gutierrez@vetopia.com\",\n  \"contrasena\": \"vet123\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Login cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
